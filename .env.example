# Keycloak Configuration
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=damplab
VITE_KEYCLOAK_CLIENT_ID=damplabclient

# Backend API Configuration
VITE_BACKEND=

# ─── Local auth bypass (development only) ────────────────────────────────────
# Both halves must be set, and DEV_AS_ROLES in damplab-backend/.env must match
# VITE_DEV_AS_ROLES exactly. The backend's value is the one that decides what
# `myPermissions` returns; this one only drives the staff flag and the role chips.
# When they drift, the console logs an error at startup. See CANVAS/CLAUDE.md,
# "Local auth bypass".
VITE_DISABLE_AUTH=false
# Comma-separated. Empty resolves to the client baseline. Unset defaults to
# damplab-staff. Worth walking: damplab-staff, technician,
# client-unassisted-equipment-user, and empty.
VITE_DEV_AS_ROLES=damplab-staff
